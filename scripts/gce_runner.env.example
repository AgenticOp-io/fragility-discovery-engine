# Optional runner settings on GCE (copy to /etc/fragility/runner.env on the VM).
# After editing: sudo systemctl restart fragility-runner
#
# Require a shared secret for POST /api/run (browser sends X-Fragility-Run-Key).
# FRAGILITY_RUN_API_KEY=change-me-to-a-long-random-string
#
# Per-IP hourly cap (default 12).
# FRAGILITY_MAX_RUNS_PER_IP_HOUR=12
