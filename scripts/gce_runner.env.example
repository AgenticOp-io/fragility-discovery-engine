# Runner settings on GCE (copy to /etc/fragility/runner.env on the VM).
# After editing: sudo systemctl restart fragility-runner
#
# Public demos default to browse-only: anonymous POST /api/run is OFF.
# Prefer a shared secret for operator-triggered live runs:
FRAGILITY_RUN_API_KEY=change-me-to-a-long-random-string
#
# Only set this on trusted/private hosts (never on the public workbench):
# FRAGILITY_ALLOW_ANONYMOUS_RUNS=1
#
# Per-IP hourly cap when runs are enabled (default 3).
FRAGILITY_MAX_RUNS_PER_IP_HOUR=3
