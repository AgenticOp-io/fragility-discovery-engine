# Chrysalis / AgenticOps hub edge
# DO NOT edit fragility-default-ip / fragility-public
#
# hub.agenticop.io       → project directory at / ; Translation Hub at /hub/
# chrysalis.agenticop.io → Translation Hub SPA at / (product entry)

# HTTP → HTTPS (both names)
server {
    listen 80;
    listen [::]:80;
    server_name hub.agenticop.io chrysalis.agenticop.io;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/chrysalis/acme;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- hub.agenticop.io: network directory + /hub/ app ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hub.agenticop.io;

    ssl_certificate     /etc/letsencrypt/live/hub.agenticop.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hub.agenticop.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = / {
        root /var/www/chrysalis/projects;
        rewrite ^ /index.html break;
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        root /var/www/chrysalis/projects;
        add_header Cache-Control "no-cache";
    }
    location = /agenticops.css {
        root /var/www/chrysalis/projects;
    }
    location = /logo.svg {
        root /var/www/chrysalis/projects;
    }
    location = /projects {
        return 301 /;
    }
    location = /projects/ {
        return 301 /;
    }

    location = /hub {
        return 302 /hub/;
    }
    location = /hub/ {
        proxy_pass http://127.0.0.1:19090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 512m;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:19090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 512m;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;
    }

    add_header X-AgenticOps-Product "agenticops-hub-directory" always;
}

# --- chrysalis.agenticop.io: Translation Hub product entry ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name chrysalis.agenticop.io;

    ssl_certificate     /etc/letsencrypt/live/hub.agenticop.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hub.agenticop.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Old /hub/ bookmarks on this host → product root
    location = /hub {
        return 301 /;
    }
    location = /hub/ {
        return 301 /;
    }

    # Directory lives on hub.agenticop.io
    location = /projects {
        return 302 https://hub.agenticop.io/;
    }
    location = /projects/ {
        return 302 https://hub.agenticop.io/;
    }

    location / {
        proxy_pass http://127.0.0.1:19090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 512m;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;
    }

    add_header X-AgenticOps-Product "chrysalis-translation-hub" always;
}
